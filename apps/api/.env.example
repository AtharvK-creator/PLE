# ============================================================
# PLE — API Environment Variables
# Copy to apps/api/.env and fill in your values
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host/ple?sslmode=require"

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- AI Gateway ---
# Primary provider: gemini | groq
AI_PROVIDER=gemini

# Gemini (primary)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_MODEL_QUIZ=gemini-2.5-flash-lite-preview-06-17

# Groq (fallback — optional)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MODEL_QUIZ=llama-3.1-8b-instant

# --- Google OAuth (optional for MVP) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Analytics (PostHog) ---
POSTHOG_API_KEY=your-posthog-server-api-key
POSTHOG_HOST=https://app.posthog.com

# --- Webhooks (n8n integration) ---
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="PLE Support <your_email@gmail.com>"
FRONTEND_URL=http://localhost:3005

